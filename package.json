    "lint": "expo lint",
    "test:notifications-routing": "npx -y tsx scripts/test_notification_routing.ts",
    "test:notifications-payload": "npx -y tsx scripts/test_notification_payload_contract.ts",
    "test:chat-filter": "npx -y tsx scripts/test_chat_filter_contract.ts",
    "test:chat-ux": "npx -y tsx scripts/test_chat_ux_contract.ts",
