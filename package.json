    "bootstrap:runtime-settings": "npx -y tsx scripts/bootstrap_runtime_settings.ts",
    "test:prod-migration": "npx -y tsx scripts/test_prod_migration_readiness.ts && npx -y tsx scripts/test_prod_schema_readiness.ts /tmp/prod_ready_public_schema.sql && npx -y tsx scripts/test_bootstrap_runtime_settings.ts",
