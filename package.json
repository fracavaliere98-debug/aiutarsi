    "test:gemma-help-massive": "npx -y tsx scripts/test_gemma_help_massive.ts",
    "test:profile-demographics": "npx -y tsx scripts/test_profile_demographics.ts",
    "test:password-validation": "npx -y tsx scripts/test_password_validation_contract.ts",
    "test:gamification-legacy-consistency": "npx -y tsx scripts/test_gamification_legacy_consistency_contract.ts",
    "test:monitoring-contract": "npx -y tsx scripts/test_monitoring_contract.ts",
