    "release:smoke": "npx -y tsx scripts/run_release_smoke.ts",
    "smoke:chat:staging": "npx -y tsx scripts/run_staging_chat_smoke.ts full",
    "smoke:activities:staging": "npx -y tsx scripts/run_staging_activity_smoke.ts full",
    "smoke:notifications:staging": "npx -y tsx scripts/run_staging_notification_smoke.ts full",
    "smoke:gamification:staging": "npx -y tsx scripts/run_staging_gamification_smoke.ts full",
    "smoke:smart-match:staging": "npx -y tsx scripts/run_staging_smart_match_smoke.ts full",
